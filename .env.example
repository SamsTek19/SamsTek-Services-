# Supabase — from Dashboard → Settings → API (URL + keys must be from the SAME project)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
VITE_SUPABASE_ANON_KEY=your-anon-jwt-key

# Hero background video (optional — place hero.mp4 in public/videos/ or use CDN URL)
# VITE_HERO_VIDEO_URL=https://res.cloudinary.com/your-cloud/video/upload/hero.mp4

# Payments use Paystack Shop: https://paystack.shop/pay/samstek_
# (configured in src/lib/site.ts — optional override)
# VITE_PAYSTACK_PAYMENT_URL=https://paystack.shop/pay/samstek_

# Optional: inline Paystack popup (not used when Shop URL is set)
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx

# Admin demo login when Supabase is not configured
VITE_ADMIN_DEMO_PASSWORD=admin123

# --- Supabase Edge Function secrets (set in Supabase Dashboard → Edge Functions) ---
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RESEND_API_KEY=re_xxxxxxxx
# FROM_EMAIL=SamsTek Services <noreply@yourdomain.com>
# SUPPORT_EMAIL=samstekservices@gmail.com
# SUPPORT_PHONE=0551694282 / 0508589087
